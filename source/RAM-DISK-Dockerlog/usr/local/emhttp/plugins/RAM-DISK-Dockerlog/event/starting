# Check if we already modified the rc.docker
if [[ ! -f /tmp/RAM-DISK-Dockerlog/modified ]]; then

# Make absolutely sure we can modify the file savely!
if grep -q 'nohup $UNSHARE --propagation slave -- $DOCKER' /etc/rc.d/rc.docker && grep -q "tear down the bridge" /etc/rc.d/rc.docker; then

    #Protection check for possible meddling via go file
    if ! grep -q "rsync" /etc/rc.d/rc.docker; then
        
        sed -i '/nohup $UNSHARE --propagation slave -- $DOCKER/i \
         # move json/logs to RAM-Disk\
         rsync -aH --delete /var/lib/docker/containers/ ${DOCKER_APP_CONFIG_PATH%/}/containers_backup\
         mountpoint -q /var/lib/docker/containers || mount -t tmpfs tmpfs /var/lib/docker/containers || { logger -t docker Error: RAM-Disk could not be mounted! && /usr/local/emhttp/plugins/dynamix/scripts/notify -e "RAM-DISK-Dockerlog" -s "Error: RAM-Disk could not be mounted!" -i alert; }\
         rsync -aH --delete ${DOCKER_APP_CONFIG_PATH%/}/containers_backup/ /var/lib/docker/containers\
         logger -t docker RAM-Disk created' /etc/rc.d/rc.docker

        sed -i '/tear down the bridge/i \
         # backup json/logs and remove RAM-Disk\
         rsync -aH --delete /var/lib/docker/containers/ ${DOCKER_APP_CONFIG_PATH%/}/containers_backup\
         umount /var/lib/docker/containers || { logger -t docker Error: RAM-Disk could not be unmounted! && /usr/local/emhttp/plugins/dynamix/scripts/notify -e "RAM-DISK-Dockerlog" -s "Error: RAM-Disk could not be unmounted!" -i alert; }\
         rsync -aH --delete ${DOCKER_APP_CONFIG_PATH%/}/containers_backup/ /var/lib/docker/containers\
         logger -t docker RAM-Disk removed' /etc/rc.d/rc.docker


        #load and set backup interval
        interval=$(sed -n '1p' /boot/config/plugins/RAM-DISK-Dockerlog/settings.cfg)
        interval=${interval:-30}
        metadata=$(sed -n '2p' /boot/config/plugins/RAM-DISK-Dockerlog/settings.cfg)
        metadata=${metadata:-0}
        logging=$(sed -n '3p' /boot/config/plugins/RAM-DISK-Dockerlog/settings.cfg)
        logging=${logging:-0}
        cat > /tmp/RAM-DISK-Dockerlog/monitor << EOF
        <?php
        \$sync_interval_minutes=${interval};
        \$sync_metadata=${metadata};
        \$sync_logging=${logging};
        if (!empty(\$sync_interval_minutes) && ! ((date("i") * date("H") * 60 + date("i")) % \$sync_interval_minutes) && file_exists("/var/lib/docker/containers")) {
          exec('
            [[ ! -d /var/lib/docker_bind ]] && mkdir /var/lib/docker_bind
            if ! mountpoint -q /var/lib/docker_bind; then
              if ! mount --bind /var/lib/docker /var/lib/docker_bind; then
                /usr/local/emhttp/plugins/dynamix/scripts/notify -e "RAM-DISK-Dockerlog" -s "Error: RAM-Disk bind mount failed!" -i alert
                logger -t docker Error: RAM-Disk bind mount failed!
              fi
            fi
            if mountpoint -q /var/lib/docker_bind; then
              rsync -aH --delete /var/lib/docker/containers/ /var/lib/docker_bind/containers &&  [ ' . (int)\$sync_logging . ' -eq 1 ]  && logger -t docker Success: Backup of RAM-Disk created.
              umount -l /var/lib/docker_bind
            else
              /usr/local/emhttp/plugins/dynamix/scripts/notify -e "RAM-DISK-Dockerlog" -s "Error: RAM-Disk bind mount failed!" -i alert
              logger -t docker Error: RAM-Disk bind mount failed!
            fi
          ');
        } else {

	if ( !empty(\$sync_metadata) && file_exists("/var/lib/docker/containers") ) {
	exec('
	  [[ ! -d /var/lib/docker_bind ]] && mkdir /var/lib/docker_bind
	  if ! mountpoint -q /var/lib/docker_bind; then
              if ! mount --bind /var/lib/docker /var/lib/docker_bind; then
                /usr/local/emhttp/plugins/dynamix/scripts/notify -e "RAM-DISK-Dockerlog" -s "Error: RAM-Disk bind mount failed!" -i alert
                logger -t docker Error: RAM-Disk bind mount failed!
              fi
            fi
            if mountpoint -q /var/lib/docker_bind; then
              find /var/lib/docker_bind/containers/ -type f -name "*-json.log" -print0 |
              while IFS= read -r -d "" file; do
                  jsonsource="\${file#/var/lib/docker_bind/containers/}"

                  if [[ ! -f "/var/lib/docker/containers/\$jsonsource" ]]; then
                      rm -- "\$file"
                  fi
              done            
              rsync -aH --delete --exclude="*-json.log" /var/lib/docker/containers/ /var/lib/docker_bind/containers &&  [ ' . (int)\$sync_logging . ' -eq 1 ]  && logger -t docker Success: Integrity Sync.
              umount -l /var/lib/docker_bind
            else
              /usr/local/emhttp/plugins/dynamix/scripts/notify -e "RAM-DISK-Dockerlog" -s "Error: RAM-Disk bind mount failed!" -i alert
              logger -t docker Error: RAM-Disk bind mount failed!
            fi
	  ');
	}
	}
EOF
  
        sed -i "/^<?PHP$/a include_once('/tmp/RAM-DISK-Dockerlog/monitor');" /usr/local/emhttp/plugins/dynamix/scripts/monitor
        echo $version > /tmp/RAM-DISK-Dockerlog/modified

    else
        /usr/local/emhttp/plugins/dynamix/scripts/notify -e "RAM-DISK-Dockerlog" -s "Error: rc.docker incompatible!" -d " The rc.docker file is modified, possibly by the go file" -i alert
        logger -t RAM-DISK-Dockerlog "Error: rc.docker is modified, possibly by the go file"
    fi
else
    /usr/local/emhttp/plugins/dynamix/scripts/notify -e "RAM-DISK-Dockerlog" -s "Error: rc.docker incompatible!" -d "Please head to the support thread of the plugin and post about your issue" -i alert
    logger -t RAM-DISK-Dockerlog "Error: rc.docker incompatible!"
fi
fi
